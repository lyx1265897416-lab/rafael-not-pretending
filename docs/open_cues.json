[{"s": 4.75, "e": 5.9, "who": "Rafael", "en": "Evan again?", "zh": "又是 Evan？"}, {"s": 5.95, "e": 9.85, "who": "Her", "en": "Fourth call today. We broke up a month ago.", "zh": "今天第四个电话了。我们分手一个月了。"}, {"s": 9.9, "e": 14.8, "who": "Rafael", "en": "Want your roommate to pick up? I'm very convincing.", "zh": "要不要你室友帮你接？我演得很像的。"}, {"s": 14.9, "e": 16.45, "who": "Her", "en": "Tempting. No.", "zh": "很诱人。不用。"}, {"s": 16.51, "e": 18.51, "who": "Her", "en": "Drinks with Maya at Cole's. Don't wait up.", "zh": "和 Maya 去 Cole 那儿喝一杯。不用等我。"}, {"s": 18.51, "e": 20.51, "who": "Rafael", "en": "I'll be at Cole's later anyway.", "zh": "反正我晚点也会去 Cole 那儿。"}, {"s": 20.51, "e": 22.31, "who": "Rafael", "en": "Text me if he shows.", "zh": "他要是出现，给我发消息。"}, {"s": 28.31, "e": 31.41, "zh": "得了吧，你连坐都坐不稳了。我送你回家。", "en": "Come on. You can barely sit up. I'll drive you home.", "who": "Evan"}, {"s": 32.11, "e": 34.46, "zh": "不用。我好着呢。好得很。", "en": "No. I'm good. I'm so good.", "who": "Her"}, {"s": 39.36, "e": 39.91, "zh": "走吧。", "en": "Let's go.", "who": "Evan"}, {"s": 45.88, "e": 47.63, "zh": "哇……我接住你了。", "en": "Whoa. I got you.", "who": "Rafael"}, {"s": 49.23, "e": 49.93, "zh": "Rafa。", "en": "Rafa.", "who": "Her"}, {"s": 51.73, "e": 53.43, "zh": "这是我男朋友。", "en": "This is my boyfriend.", "who": "Her"}, {"s": 53.64, "e": 56.34, "zh": "什么时候的事？你们俩不是“只是朋友”吗。", "en": "Since when? You two are just friends.", "who": "Evan"}, {"s": 58.1, "e": 58.8, "zh": "吻我。", "en": "Kiss me.", "who": "Her"}, {"s": 59.2, "e": 60.35, "zh": "让他信以为真。", "en": "Make him believe it.", "who": "Her"}, {"s": 78.19, "e": 78.79, "zh": "他走了。", "en": "He's gone.", "who": "Rafael"}, {"s": 80.34, "e": 80.84, "zh": "嗯。", "en": "Yeah.", "who": "Her"}, {"s": 84.24, "e": 87.84, "zh": "好了。喝水。然后我送你回家。", "en": "Okay. Water. Then I'm taking you home.", "who": "Rafael"}, {"s": 97.03, "e": 97.83, "zh": "醒了？", "en": "Awake?", "who": "Rafael"}, {"s": 98.22, "e": 99.08, "zh": "水在这里。", "en": "Water’s here.", "who": "Rafael"}, {"s": 99.47, "e": 101.08, "zh": "要是头疼，先别喝咖啡。", "en": "Leave the coffee if your head hurts.", "who": "Rafael"}, {"s": 101.67, "e": 103.03, "zh": "昨晚那场临时男友任务，", "en": "Temporary boyfriend duty last night.", "who": "Rafael"}, {"s": 103.17, "e": 104.08, "zh": "我觉得自己表现还不错。", "en": "I thought I did all right.", "who": "Rafael"}, {"s": 104.92, "e": 106.92, "zh": "不过，有件事得说清楚。", "en": "One thing needs clearing up, though.", "who": "Rafael"}, {"s": 107.83, "e": 109.88, "zh": "替你挡住 Evan，是演的。", "en": "Keeping Evan off your back was an act.", "who": "Rafael"}, {"s": 111.13, "e": 112.58, "zh": "想吻你，不是。", "en": "Wanting to kiss you wasn’t.", "who": "Rafael"}, {"s": 113.42, "e": 115.02, "zh": "我喜欢你。", "en": "I like you.", "who": "Rafael"}, {"s": 116.17, "e": 117.63, "zh": "有一阵子了。", "en": "Have for a while.", "who": "Rafael"}, {"s": 118.73, "e": 121.08, "zh": "昨晚不代表你答应过任何事。", "en": "Last night doesn’t mean you agreed to anything.", "who": "Rafael"}, {"s": 122.11, "e": 123.77, "zh": "你愿意和我约会吗？", "en": "Will you go on a date with me?", "who": "Rafael"}, {"s": 124.13, "e": 125.02, "zh": "一次真正的约会。", "en": "A real date.", "who": "Rafael"}, {"s": 125.52, "e": 128.23, "zh": "不是因为刚好顺路，就一起吃顿饭。", "en": "Not just dinner because we happen to be heading the same way.", "who": "Rafael"}]