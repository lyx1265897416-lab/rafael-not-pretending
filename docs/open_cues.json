[{"s": 0.2, "e": 3.3, "zh": "得了吧，你连坐都坐不稳了。我送你回家。", "en": "Come on. You can barely sit up. I'll drive you home.", "who": "Evan"}, {"s": 4.0, "e": 6.35, "zh": "不用。我好着呢。好得很。", "en": "No. I'm good. I'm so good.", "who": "Her"}, {"s": 11.25, "e": 11.8, "zh": "走吧。", "en": "Let's go.", "who": "Evan"}, {"s": 17.77, "e": 19.52, "zh": "哇……我接住你了。", "en": "Whoa. I got you.", "who": "Rafael"}, {"s": 21.12, "e": 21.82, "zh": "Rafa。", "en": "Rafa.", "who": "Her"}, {"s": 23.62, "e": 25.32, "zh": "这是我男朋友。", "en": "This is my boyfriend.", "who": "Her"}, {"s": 25.53, "e": 28.23, "zh": "什么时候的事？你们俩不是“只是朋友”吗。", "en": "Since when? You two are just friends.", "who": "Evan"}, {"s": 29.99, "e": 30.69, "zh": "吻我。", "en": "Kiss me.", "who": "Her"}, {"s": 31.09, "e": 32.24, "zh": "让他信以为真。", "en": "Make him believe it.", "who": "Her"}, {"s": 50.08, "e": 50.68, "zh": "他走了。", "en": "He's gone.", "who": "Rafael"}, {"s": 52.23, "e": 52.73, "zh": "嗯。", "en": "Yeah.", "who": "Her"}, {"s": 56.13, "e": 59.73, "zh": "好了。喝水。然后我送你回家。", "en": "Okay. Water. Then I'm taking you home.", "who": "Rafael"}, {"s": 63.86, "e": 64.66, "zh": "醒了？", "en": "Awake?", "who": "Rafael"}, {"s": 65.06, "e": 65.91, "zh": "水在这里。", "en": "Water’s here.", "who": "Rafael"}, {"s": 66.31, "e": 67.91, "zh": "要是头疼，先别喝咖啡。", "en": "Leave the coffee if your head hurts.", "who": "Rafael"}, {"s": 68.51, "e": 69.86, "zh": "昨晚那场临时男友任务，", "en": "Temporary boyfriend duty last night.", "who": "Rafael"}, {"s": 70.01, "e": 70.91, "zh": "我觉得自己表现还不错。", "en": "I thought I did all right.", "who": "Rafael"}, {"s": 71.76, "e": 73.76, "zh": "不过，有件事得说清楚。", "en": "One thing needs clearing up, though.", "who": "Rafael"}, {"s": 74.66, "e": 76.71, "zh": "替你挡住 Evan，是演的。", "en": "Keeping Evan off your back was an act.", "who": "Rafael"}, {"s": 77.96, "e": 79.41, "zh": "想吻你，不是。", "en": "Wanting to kiss you wasn’t.", "who": "Rafael"}, {"s": 80.26, "e": 81.86, "zh": "我喜欢你。", "en": "I like you.", "who": "Rafael"}, {"s": 83.01, "e": 84.46, "zh": "有一阵子了。", "en": "Have for a while.", "who": "Rafael"}, {"s": 85.56, "e": 87.91, "zh": "昨晚不代表你答应过任何事。", "en": "Last night doesn’t mean you agreed to anything.", "who": "Rafael"}, {"s": 88.94, "e": 90.61, "zh": "你愿意和我约会吗？", "en": "Will you go on a date with me?", "who": "Rafael"}, {"s": 90.96, "e": 91.86, "zh": "一次真正的约会。", "en": "A real date.", "who": "Rafael"}, {"s": 92.36, "e": 95.06, "zh": "不是因为刚好顺路，就一起吃顿饭。", "en": "Not just dinner because we happen to be heading the same way.", "who": "Rafael"}]